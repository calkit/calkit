# Pinned tool and package versions for round 2 of the audit comparison
OPENRESEARCH_VERSION=v0.2.30
OPENRESEARCH_TARGET=aarch64-apple-darwin
LIGHTCONE_CLI_VERSION=0.5.1
ASTRA_TOOLS_VERSION=0.2.18
PYTHON_VERSION=3.12
# Analysis packages, the same in every arm
PACKAGES="numpy==2.5.5 pandas==3.1.1 statsmodels==0.15.0 matplotlib==3.11.2"
# Notebook packages, only the no-framework arm runs a notebook
NOTEBOOK_PACKAGES="nbconvert==7.16.5 ipykernel==7.4.0"
# Calkit runs from the calkit-s3 worktree, at commit 09d49f10a for round 2
# Calkit as checked out for the round; see CALKIT_COMMIT for its version
CALKIT_REPO="${CALKIT_REPO:-$(git rev-parse --show-toplevel)}"
CALKIT_COMMIT=09d49f10afe0e8a964de6b465a2a0ff0d98919bc
# Round 1's installs, reused
# Where round 1's install scripts put the tools
ROUND_1_TOOLS="${ROUND_1_TOOLS:-$(git rev-parse --show-toplevel)/research/audit-speed/tools}"
