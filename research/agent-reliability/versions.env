# Pinned versions for the agent reliability benchmark, matching round 2.
# The harness's own environment is the uv project here (pyproject.toml), and
# each trial's venv gets these packages at the versions its uv.lock pins.
# The Calkit under test is pinned by commit in ../calkit.yaml.
PYTHON_VERSION=3.12.16
# Analysis packages, the same in every arm
PACKAGES="numpy==2.5.5 pandas==3.1.1 statsmodels==0.15.0 matplotlib==3.11.2"
# Notebook packages, which only the none and messy arms use
NOTEBOOK_PACKAGES="nbconvert==7.16.5 ipykernel==7.4.0"
