%% calkit.sty -- provenance markers for content injected from a Calkit
%% project. Installed beside a document by `calkit latex build
%% --provenance`; see https://docs.calkit.org/provenance.
%%
%% Every macro here is a no-op wrapper in the default (final) mode, so a
%% document renders identically with or without provenance markers. With
%% the `provenance` option, injected values are colored so a reader can see
%% they came from elsewhere, and every injection -- value, figure, text
%% block -- is logged to \jobname.ckprov, which Calkit turns into
%% <document>.provenance.json for editors and the hub to follow back to the
%% file and the stage that produced it. Nothing else is added to the page.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{calkit}[2026/08/29 v0.2 Calkit provenance markers]
\RequirePackage{xcolor}
\newif\ifck@prov
\DeclareOption{provenance}{\ck@provtrue}
\DeclareOption{final}{\ck@provfalse}
\ProcessOptions\relax
\definecolor{ckprov}{HTML}{1F6FB2}
% Artifact table, generated per build into calkit-provenance.tex:
% \ckartifact{path as the document writes it}{stage}{hash}{project path}
\newcommand\ckartifact[4]{\expandafter\gdef\csname ck@stage@#1\endcsname{#2}%
  \expandafter\gdef\csname ck@hash@#1\endcsname{#3}%
  \expandafter\gdef\csname ck@proj@#1\endcsname{#4}}
\newcommand\ckstageof[1]{\ifcsname ck@stage@#1\endcsname
  \csname ck@stage@#1\endcsname\else ?\fi}
\newcommand\ckprojectpath[1]{\ifcsname ck@proj@#1\endcsname
  \csname ck@proj@#1\endcsname\else#1\fi}
\InputIfFileExists{calkit-provenance.tex}{}{}
% Log of every injection, one JSON object per line
\newwrite\ck@provfile
\AtBeginDocument{\immediate\openout\ck@provfile=\jobname.ckprov\relax}
\AtEndDocument{\immediate\closeout\ck@provfile}
\newcommand\ck@log[3]{\immediate\write\ck@provfile{%
  {"kind": "#1", "path": "#2", "key": "#3", "page": \thepage}}}
\newcommand\ck@mark[1]{\ifck@prov\textcolor{ckprov}{#1}\else#1\fi}
% \ckvalue{key}{value}{path}{stage}: a number or string read from a
% results file. Generated value commands expand to this.
\newcommand\ckvalue[4]{\ck@log{value}{#3}{#1}\ck@mark{#2}}
% \ckfigure[graphics options]{path}: \includegraphics, logged
\newcommand\ckfigure[2][]{\ck@log{figure}{#2}{}\includegraphics[#1]{#2}}
% \ckinput{path}: \input, logged, for stage-generated text
\newcommand\ckinput[1]{\ck@log{text}{#1}{}\input{#1}}
% \ckblock{n}{path}: marks a generated question block, logged
\newcommand\ckblock[2]{\ck@log{block}{#2}{#1}}
