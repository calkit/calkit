# Domain
# This would be set to the production domain with an env var on deployment
DOMAIN=localhost

# Environment: local, staging, production
ENVIRONMENT=local

# Frontend URL for local development (used for Stripe checkout redirects)
FRONTEND_HOST=http://localhost:5173

PROJECT_NAME="Calkit (dev)"
STACK_NAME=calkit

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"
SECRET_KEY=
FERNET_KEY=
# For key rotation: comma-separated list of keys, with the first being the active key
FERNET_KEYS=
FIRST_SUPERUSER=you@youremail.com
FIRST_SUPERUSER_PASSWORD=
FIRST_SUPERUSER_GITHUB_USERNAME=

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@calkit.io
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Shared cache. Unset to run without one: reads just recompute.
REDIS_URL=redis://cache:6379/0

# Where project clones live; a named volume so a deploy does not re-clone
# every project for every viewer.
CLONE_ROOT=/clones

SENTRY_DSN=

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# Object storage config
# The root this hub stores objects under, usually just a bucket, e.g.
# gs://calkit-production; DVC data goes in a data/ folder within it.
# The scheme picks the backend: s3:// for AWS S3 and anything
# S3-compatible (the bundled MinIO, Cloudflare R2, DigitalOcean
# Spaces, ...), gs:// for Google
OBJECT_STORAGE_PREFIX=s3://calkit
# To host object storage in this stack rather than pointing at an
# external service, run Compose with --profile objects (as `make dev`
# does) or export COMPOSE_PROFILES=objects; the bundled MinIO
# container is configured from the credentials below.
# Where that API lives; leave blank for AWS S3 itself, and blank the
# credentials too to use the standard AWS credential chain
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_KEY=root
OBJECT_STORAGE_SECRET=changethis

# Emails allowed to sign up and log in, comma-separated. Leave blank
# for a public hub; set it to lock a private or pre-release instance
# (e.g., staging) down to specific people
ALLOWED_USER_EMAILS=

# Projects showcased on the landing page and to users who haven't created
# anything yet, as comma-separated owner/name slugs, shown in this order.
# Leave blank for the built-in list of Calkit examples. Slugs naming a
# private or missing project are skipped rather than erroring
FEATURED_PROJECTS=

# Where in-app feedback, bug reports, and help requests are emailed.
# Leave blank to send them to FIRST_SUPERUSER
FEEDBACK_EMAIL=

# GitHub
GH_CLIENT_ID=
GH_CLIENT_SECRET=
# GitHub App private key PEM contents (one line, use \n for newlines, or a
# quoted multi-line value). Lets GitHub-less members push. Optional in dev;
# without it they can only read public projects.
GH_APP_PRIVATE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Mixpanel
MIXPANEL_TOKEN=

# Zenodo
ZENODO_CLIENT_ID=
ZENODO_CLIENT_SECRET=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Grafana (observability stack)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Zotero
ZOTERO_CLIENT_KEY=
ZOTERO_CLIENT_SECRET=
