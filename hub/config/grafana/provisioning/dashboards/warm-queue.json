{
  "title": "Warm queue",
  "uid": "warm-queue",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Workers by state",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (state) (rq_workers{job=\"rq\"})",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Queue depth",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (queue, status) (rq_jobs{job=\"rq\"})",
          "legendFormat": "{{queue}} {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Jobs finished per minute",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(rq_workers_success_total{job=\"rq\"}[5m])) * 60",
          "legendFormat": "succeeded"
        },
        {
          "expr": "sum(rate(rq_workers_failed_total{job=\"rq\"}[5m])) * 60",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 4,
      "title": "Failed jobs (total)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rq_workers_failed_total{job=\"rq\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Workers alive",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rq_workers{job=\"rq\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Worker busy time per minute (s)",
      "type": "timeseries",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(rq_workers_working_time_total{job=\"rq\"}[5m])) * 60",
          "legendFormat": "busy seconds/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 7,
      "title": "Backend request rate during warms (req/s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=~\"backend|backend-dvc\"}[2m]))",
          "legendFormat": "requests"
        }
      ]
    },
    {
      "id": 8,
      "title": "Queued but not started",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rq_jobs{job=\"rq\",status=\"queued\"})",
          "legendFormat": "queued"
        }
      ]
    }
  ]
}
